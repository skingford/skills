#!/bin/bash
# [git-clean-main] Clean up AI files after merge on main/master

AI_FILES=(
  # AI Agent Platforms
  ".claude" ".codex" ".augment" ".devin" ".bolt" ".v0" ".replit"
  # AI-Enhanced IDEs
  ".cursor" ".windsurf" ".trae" ".kiro" ".junie" ".aide"
  # AI Coding Assistants
  ".cline" ".roo" ".continue" ".cody" ".aider" ".copilot" ".tabnine" ".codeium" ".gemini" ".amazonq"
  # Config & Rules Files
  "openspec" "skills-lock.json" "AGENTS.md" ".cursorrules" ".cursorignore" ".windsurfrules" ".clinerules" ".roomodes" ".aider.conf.yml" ".aiderignore"
  # Other Tools
  ".obsidian"
  # Agent install dirs
  ".agents"
)

is_main_branch() {
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || return 1
  [[ "$branch" == "main" || "$branch" == "master" ]]
}

is_main_branch || exit 0

removed=()
for item in "${AI_FILES[@]}"; do
  if [ -e "$item" ]; then
    git rm -rf --cached "$item" 2>/dev/null || true
    rm -rf "$item" 2>/dev/null || true
    removed+=("$item")
  fi
done

if [ ${#removed[@]} -gt 0 ]; then
  echo "🧹 [git-clean-main] Cleaned AI files after merge on $(git symbolic-ref --short HEAD):"
  printf '   - %s\n' "${removed[@]}"
  git commit --amend --no-edit
  echo "   Merge commit updated to exclude AI files."
fi
